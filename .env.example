# ==============================================================================
# SCopyTrade Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your deployment-specific configuration.
# Never commit .env with real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# Port the Express/WebSocket server listens on (defaults to 3000)
PORT=3000

# Node runtime environment (development | production | test)
NODE_ENV=development

# Allowed frontend origin for CORS and WebSocket handshake origin validation
FRONTEND_URL=https://your-frontend-domain.com

# Optional local frontend origin for local development CORS
FRONTEND_LOCALHOST=http://localhost:5173

# Set to "true" in production behind HTTPS to ensure session cookies have the Secure flag
COOKIE_SECURE=false

# Optional server outbound public IP override. If left empty, the server automatically
# queries outbound IP echo providers (api.ipify.org, ifconfig.me, myip.com) and caches
# the result for 5 minutes. Useful for checking exchange API whitelist consistency.
SERVER_OUTBOUND_IP=

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. mongodb+srv://user:pass@cluster.mongodb.net/dbname).
# IMPORTANT: Multi-document transactions are used for finance and copy flows.
# Self-hosted MongoDB must be initialized as a replica set; Atlas enables this by default.
MONGO_URI=

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT, OTP & REGISTRATION)
# ------------------------------------------------------------------------------
# Primary secret used for signing and verifying JWT tokens (access, refresh, and WS).
JWT_SECRET=

# Optional dedicated secret for access tokens. Falls back to JWT_SECRET if unset.
JWT_ACCESS_SECRET=

# Optional dedicated secret for refresh tokens. Falls back to JWT_SECRET if unset.
JWT_REFRESH_SECRET=

# JWT token expirations (e.g. 15m, 1h, 7d). REQUIRED: Application throws on startup if empty.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Secret used to HMAC-SHA256 hash email OTP codes at rest.
# MUST be at least 32 bytes (long random string). Application throws if shorter.
OTP_SECRET=

# Expiration window for email verification OTP codes in minutes (defaults to 10)
OTP_EXPIRY_MINUTES=10

# Default status for new user registrations (active | waitlist). Set to active for immediate access.
SIGNUP_DEFAULT_STATUS=waitlist

# ------------------------------------------------------------------------------
# 4. EXCHANGE CREDENTIAL ENCRYPTION & TRADING ENVIRONMENT
# ------------------------------------------------------------------------------
# 64-character hexadecimal string (32 bytes) used for AES-256-GCM encryption of
# user exchange API keys and secrets at rest. REQUIRED: Application throws if not 64 hex chars.
EXCHANGE_ENCRYPTION_KEY=

# Global exchange trading mode (live | testnet). Safe default is testnet.
# When set to live, real trading orders can be submitted using live credentials.
EXCHANGE_MODE=testnet

# Optional exchange-specific demo overrides.
# In live mode (EXCHANGE_MODE=live), these default to false (live trading).
# Set to "true" to force simulated trading (Bitget paptrading / OKX simulated trading).
BITGET_DEMO_MODE=true
OKX_DEMO_MODE=true

# Optional maximum allowed percentage entry price deviation between signal and execution (e.g. 0.005 for 0.5%).
TRADE_ENTRY_DEVIATION_LIMIT=

# Rebase signal prices on testnet so orders align with current testnet market price. Defaults to true on testnet.
TESTNET_REBASE_SIGNAL_PRICES=true

# ------------------------------------------------------------------------------
# 5. OPTIONAL EXCHANGE REST & WEBSOCKET URL OVERRIDES
# ------------------------------------------------------------------------------
# Leave empty to use official defaults for each exchange.
# Binance
BINANCE_API_URL=https://fapi.binance.com
BINANCE_FUTURES_TEST_API_URL=https://testnet.binancefuture.com
BINANCE_WS_URL=wss://fstream.binance.com
BINANCE_FUTURES_TEST_WS_URL=wss://fstream.binancefuture.com
BINANCE_SPOT_API_URL=https://api.binance.com

# Bybit
BYBIT_API_URL=https://api.bybit.com
BYBIT_TEST_API_URL=https://api-testnet.bybit.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/private
BYBIT_TEST_WS_URL=wss://stream-testnet.bybit.com/v5/private

# Bitget
BITGET_API_URL=https://api.bitget.com
BITGET_BASE_URL=https://api.bitget.com
BITGET_WS_URL=wss://ws.bitget.com/v2/ws/private

# OKX
OKX_API_URL=https://www.okx.com
OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/private

# ------------------------------------------------------------------------------
# 6. EMAIL DELIVERY (GOOGLE GMAIL API OAUTH 2.0)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 credentials authorized with the `https://www.googleapis.com/auth/gmail.send` scope.
# Required for sending OTP codes, welcome emails, trade notifications, and alerts.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=SCopyTrade

# ------------------------------------------------------------------------------
# 7. CLOUDINARY MEDIA STORAGE (AVATARS & PRO-TRADER IMAGES)
# ------------------------------------------------------------------------------
# Required for uploading and serving trader avatars and produce images.
# Uploads are buffered in memory and streamed directly to Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 8. PLATFORM FEE WITHDRAWALS & WALLETS (COPIER TO PLATFORM)
# ------------------------------------------------------------------------------
# Blockchain network for platform fee withdrawals from copier accounts (must be TRON)
PLATFORM_USDT_NETWORK=TRON

# Mainnet TRON Base58Check address to receive platform fees when EXCHANGE_MODE=live
PLATFORM_USDT_WALLET_ADDRESS=

# TRON-format address used to receive test assets when EXCHANGE_MODE=testnet
PLATFORM_USDT_TESTNET_WALLET_ADDRESS=

# Withdrawal execution mode (dry-run | live). Keep as dry-run until explicitly moving real assets.
PROFIT_WITHDRAWAL_MODE=dry-run

# Dedicated TRON Base58Check wallet used only for approved cumulative profit shares
SYSTEM_WALLET_ADDRESS=
SYSTEM_WALLET_NETWORK=TRON

# Polling parameters for exchange on-chain withdrawal completion
WITHDRAWAL_STATUS_POLL_INTERVAL_MS=5000
WITHDRAWAL_STATUS_POLL_MAX_ATTEMPTS=120

# Required for live OKX USDT-TRON withdrawals. Set according to current OKX currency withdrawal fee table.
OKX_USDT_TRON_WITHDRAWAL_FEE=

# ------------------------------------------------------------------------------
# 9. PRO-TRADER PAYOUTS & TRON BLOCKCHAIN
# ------------------------------------------------------------------------------
# Platform-to-pro USDT payouts mode (demo | live)
PRO_PAYOUT_MODE=demo

# Master safety switch for live TRON payouts to pro traders (must be explicitly true for real transactions)
PRO_PAYOUT_LIVE_ENABLED=false

# Allows manual funding simulation for demo payouts in development
PRO_DEMO_FUNDING_ENABLED=false

# TRON Full Node API host (defaults to https://api.trongrid.io)
TRON_FULL_HOST=https://api.trongrid.io

# Company TRON private key (hex string) used to sign smart contract payouts when PRO_PAYOUT_LIVE_ENABLED=true
TRON_COMPANY_PRIVATE_KEY=

# TRC-20 USDT smart contract address on TRON mainnet (defaults to official TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t)
TRON_USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Optional TronGrid API key for higher rate limits on TRON network queries
TRON_PRO_API_KEY=

# ------------------------------------------------------------------------------
# 10. TESTING & DEVELOPMENT SAFETY OVERRIDES
# ------------------------------------------------------------------------------
# Exposes temporary authenticated settlement simulation endpoints. NEVER enable in production.
ENABLE_TEMPORARY_TEST_ENDPOINTS=false
