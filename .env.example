# Gmail API OAuth 2.0 credentials. Authorize the sender with the gmail.send scope.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=SCopyTrade

# Use a long, random value (at least 32 bytes) to HMAC OTP codes at rest.
OTP_SECRET=
OTP_EXPIRY_MINUTES=10

# Set to active when new verified signups should receive immediate access.
SIGNUP_DEFAULT_STATUS=waitlist

# Copier settlement payments: users send mainnet USDT (TRC-20) to this address.
# Invoice addresses are fixed when created; changing this affects future invoices only.
SYSTEM_WALLET_ADDRESS=
SYSTEM_WALLET_NETWORK=TRON
SETTLEMENT_TRON_HOST=https://api.trongrid.io
# Enable after configuring the wallet and TronGrid key below. Hash verification
# uses the same read-only mainnet API, even when this automatic worker is off.
SETTLEMENT_AUTO_VERIFY_ENABLED=false
FRONTEND_URL=http://localhost:3001

# Never enable this in production. Exposes authenticated trade-close testing.
# The old withdraw-usdt simulator has been disabled.
ENABLE_TEMPORARY_TEST_ENDPOINTS=false

# Platform-to-pro USDT payouts (separate from copier fee collection)
PRO_PAYOUT_LIVE_ENABLED=false
TRON_FULL_HOST=https://api.trongrid.io
# Only needed for outgoing pro payouts, NEVER for receiving settlements.
TRON_COMPANY_PRIVATE_KEY=
TRON_USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# Create this in https://www.trongrid.io (see docs/settlement-payments-setup.md).
TRON_PRO_API_KEY=
