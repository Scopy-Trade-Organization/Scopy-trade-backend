# Server and database
NODE_ENV=development
PORT=3000
MONGO_URI=

# Frontend origins: deployed URL and local development URL serve different clients.
FRONTEND_URL=http://localhost:3001
FRONTEND_LOCALHOST=

# Authentication. Use long random secrets; do not reuse the JWT/OTP/encryption keys.
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
OTP_SECRET=
OTP_EXPIRY_MINUTES=10
EXCHANGE_ENCRYPTION_KEY=

# Gmail OAuth credentials for the gmail.send scope.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=SCopyTrade

# Optional profile-photo uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# One trading-environment switch for every exchange.
# testnet uses Binance/Bybit test URLs and Bitget/OKX simulated-trading headers.
# live uses real exchange accounts. This does not enable outgoing pro payouts.
EXCHANGE_MODE=testnet
TESTNET_REBASE_SIGNAL_PRICES=true
TRADE_ENTRY_DEVIATION_LIMIT=0.02

# Optional exchange endpoint overrides. Leave blank to use built-in defaults.
# Live and test URLs point to different environments, not duplicate settings.
BYBIT_API_URL=
BYBIT_WS_URL=
BYBIT_TEST_API_URL=
BYBIT_TEST_WS_URL=
BITGET_API_URL=
BITGET_WS_URL=
OKX_API_URL=

# Incoming copier settlements: the public mainnet TRON receiving address.
SYSTEM_WALLET_ADDRESS=
SETTLEMENT_AUTO_VERIFY_ENABLED=false

# Shared mainnet provider for incoming settlement checks and outgoing pro payouts.
# USDT/TRON and its mainnet token contract are fixed in code.
TRON_FULL_HOST=https://api.trongrid.io
# Create a TronGrid key: see docs/settlement-payments-setup.md.
TRON_PRO_API_KEY=

# Outgoing pro payouts: independent of exchange trading and read-only verification.
PRO_PAYOUT_LIVE_ENABLED=false
# Only needed to sign outgoing pro payouts, never for receiving settlements.
TRON_COMPANY_PRIVATE_KEY=

# Authenticated development trade-close endpoint; keep off in production.
ENABLE_TEMPORARY_TEST_ENDPOINTS=false
