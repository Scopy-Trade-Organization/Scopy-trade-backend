# Gmail API OAuth 2.0 credentials. Authorize the sender with the gmail.send scope.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=SCopyTrade

# Use a long, random value (at least 32 bytes) to HMAC OTP codes at rest.
OTP_SECRET=
OTP_EXPIRY_MINUTES=10

# Set to active when new verified signups should receive immediate access.
SIGNUP_DEFAULT_STATUS=waitlist

# TRC-20 destination for platform-fee withdrawals from users' UTA accounts.
PLATFORM_USDT_NETWORK=TRON
# Mainnet TRON address used when EXCHANGE_MODE=live.
PLATFORM_USDT_WALLET_ADDRESS=
# TRON-format address used to receive test assets when EXCHANGE_MODE=testnet.
PLATFORM_USDT_TESTNET_WALLET_ADDRESS=

# Keep this as dry-run until you explicitly intend to move real USDT.
PROFIT_WITHDRAWAL_MODE=dry-run

# TRON USDT wallet used only for approved cumulative copy-trading profit shares.
SYSTEM_WALLET_ADDRESS=
SYSTEM_WALLET_NETWORK=TRON

# Poll for up to 10 minutes (120 attempts x 5 seconds) after submission.
WITHDRAWAL_STATUS_POLL_INTERVAL_MS=5000
WITHDRAWAL_STATUS_POLL_MAX_ATTEMPTS=120
# Required for live OKX USDT-TRON withdrawals. Confirm the current fee in
# OKX currency configuration before enabling live withdrawal mode.
OKX_USDT_TRON_WITHDRAWAL_FEE=

# Never enable this in production. Exposes authenticated settlement simulators.
ENABLE_TEMPORARY_TEST_ENDPOINTS=false
