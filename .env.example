# Gmail API OAuth 2.0 credentials. Authorize the sender with the gmail.send scope.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=SCopyTrade

# Use a long, random value (at least 32 bytes) to HMAC OTP codes at rest.
OTP_SECRET=
OTP_EXPIRY_MINUTES=10

# Set to active when new verified signups should receive immediate access.
SIGNUP_DEFAULT_STATUS=waitlist
